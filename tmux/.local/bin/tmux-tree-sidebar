#!/usr/bin/env bash

# Persistent, clickable session->window tree sidebar.
# Runs fzf in a loop that never exits: select a row (click then Enter, or just
# Enter) switches the client, then fzf reloads the list and re-highlights the
# current window. Mirrors the rendering of tmux-switch-window.

self="${BASH_SOURCE[0]}"

# --list: print the colored two-level tree. Two tab-separated fields:
#   1 = colored display text — shown AND searched (--with-nth=1 --nth=1); fzf
#       ignores the ANSI codes, so the visible "index name" is what matches.
#   2 = jump target (session_id:window_index), used by {2} on enter and --pos.
# Session header rows omit field 2, so a numeric query never lands on them.
if [[ "$1" == "--list" ]]; then
	current=$(tmux display-message -p '#{session_id}:#{window_index}')
	tmux list-windows -a -F '#{session_id}|#{session_name}|#{window_index}|#{window_name}|#{?window_active,*,}' |
		grep -v '^[^|]*|_' | # ignore opensessions internal sessions
		grep -v '^[^|]*|tmux-tree' |
		sort -t'$' -k2 -n |
		awk -F'|' -v cur="$current" 'BEGIN {
			# Catppuccin Mocha: peach, green, mauve, sapphire, red, yellow, teal
			split("38;2;250;179;135|38;2;166;227;161|38;2;203;166;247|38;2;116;199;236|38;2;243;139;168|38;2;249;226;175|38;2;148;226;213", codes, "|")
			nc = 7
		} {
			if ($1 != prev) ci++
			c = "\033[" codes[(ci-1) % nc + 1] "m"
			r = "\033[0m"
			target = $1":"$3
			mark = (target == cur) ? "▸" : " "
			# index = session number (1-based) concatenated with window index,
			# matching tmux-switch-window (prefix s): $0 win 1 -> "11".
			idx = (substr($1,2)+1) $3
			if ($1 != prev) printf "%s  %s%s\n", c, $2, r
			printf "%s%s   %s %s%s\t%s\n", c, mark, idx, $4, r, target
			prev = $1
		}'
	exit 0
fi

# --pos: 1-based row index of the current window, for initial cursor placement.
if [[ "$1" == "--pos" ]]; then
	current=$(tmux display-message -p '#{session_id}:#{window_index}')
	"$self" --list | awk -F'\t' -v cur="$current" '$2 == cur {print NR; exit}'
	exit 0
fi

# Main: persistent fzf. execute() switches without exiting fzf, then reload
# refreshes the tree so the highlight follows the new current window.
# Note: --nth=1 indexes the --with-nth VIEW (only field 1 survives there), not
# the raw fields. Bumping it to search another field matches nothing silently.
#
# load fires on start AND after every reload. We use `transform` so the cursor
# row is recomputed live (via --pos) each time — a static pos(N) would freeze at
# the launch-time row and send the cursor to the wrong line after a switch.
export FZF_DEFAULT_OPTS=
"$self" --list |
	fzf --ansi --reverse --border=none --height=100% --no-info \
		--prompt=' ' --pointer='▶' --cycle \
		--delimiter='\t' --with-nth=1 --nth=1 \
		--bind "load:transform:echo \"pos(\$($self --pos))\"" \
		--bind 'enter:execute-silent(t={2}; tmux switch-client -t "$t" 2>/dev/null)+clear-query+reload('"$self"' --list)' \
		--bind 'double-click:execute-silent(t={2}; tmux switch-client -t "$t" 2>/dev/null)+clear-query+reload('"$self"' --list)' \
		>/dev/null

# fzf only exits on Esc/Ctrl-C; turn the sidebar pane off when that happens.
tmux kill-pane 2>/dev/null
