#!/usr/bin/env bash

# Kill any sidebar pane that is the last pane in its window, so the empty window
# disappears instead of lingering with only the sidebar.

[[ "$(tmux show-option -gqv '@tree-sidebar')" == "on" ]] || exit 0

# window_id | pane_id | is-sidebar(1 or empty), one row per pane.
tmux list-panes -a -F '#{window_id}|#{pane_id}|#{@is-tree-sidebar}' 2>/dev/null |
	awk -F'|' '
		{ count[$1]++; if ($3 == 1) sidebar[$1] = $2 }
		END {
			for (w in sidebar)
				if (count[w] == 1) print sidebar[w]
		}' |
	while read -r pane; do
		tmux kill-pane -t "$pane" 2>/dev/null
	done

# Always succeed: with nothing to prune the pipeline ends on read's EOF (non-zero),
# which tmux would surface as "returned 1".
exit 0
